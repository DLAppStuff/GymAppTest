{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gym-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "gym-prod-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-s", "build", "-l", "4280"],
      "port": 4280,
      "autoPort": true
    }
  ]
}
