# Copy this file to `.env.local` (which is gitignored) and fill in the values
# from your Supabase project: Dashboard → Project Settings → API.
#
# Create React App only exposes vars prefixed with REACT_APP_ to the browser.
# After changing this file, restart `npm start` for it to take effect.

REACT_APP_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
